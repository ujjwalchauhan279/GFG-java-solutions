/* 

Time Complexity: O(n)
Space Complexity: O(n)
Approach:
1. Create a HashMap to store frequency of each character
2. Traverse the string and update frequency in map
3. Find the maximum frequency among all characters
4. Initialize ans = 'z' (for lexicographically smallest handling)
5. Traverse map again
6. If character frequency equals maxfreq and ch <= ans → update ans
7. Return ans

*/




class Solution {
    public char getMaxOccuringChar(String s) {
        HashMap <Character,Integer> map = new HashMap<>();
        for(int i=0; i<s.length(); i++){
            if(map.containsKey(s.charAt(i))){
                map.put(s.charAt(i) , map.get(s.charAt(i))+1);
            }
            else map.put(s.charAt(i),1);
        }
        int maxfreq=0;
        for(char ch: map.keySet()){
            int freq = map.get(ch);
            if(freq > maxfreq) maxfreq = freq;
        }
        char ans = 'z';
        for(char ch: map.keySet()){
            if(map.get(ch)==maxfreq && ans>=ch){
                ans = ch;
            }
        }
        return ans;
    }
}
